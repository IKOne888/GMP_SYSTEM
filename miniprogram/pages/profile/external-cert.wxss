/* pages/profile/external-cert.wxss - 我的资质证书 */
.page-ext-cert {
  min-height: 100vh;
  padding: 20rpx 0 40rpx;
  background: #f5f5f5;
}

.intro-card {
  margin-bottom: 20rpx;
}

.intro-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f4e8a;
}

.intro-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}

.cert-list {
  margin-bottom: 20rpx;
}

.cert-card {
  margin-bottom: 20rpx;
}

.cert-head {
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.type-tag {
  flex-shrink: 0;
  margin-right: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #e8f0fb;
  color: #1f4e8a;
  font-size: 22rpx;
}

.cert-name {
  max-width: 360rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.status-tag {
  flex-shrink: 0;
  font-size: 24rpx;
}

.status-pending {
  color: #fa8c16;
}

.status-valid {
  color: #52c41a;
}

.status-rejected {
  color: #f5222d;
}

.cert-row {
  display: flex;
  justify-content: space-between;
  padding-top: 12rpx;
  font-size: 26rpx;
}

.row-label {
  color: #999999;
}

.row-value {
  color: #333333;
  text-align: right;
}

.text-danger {
  color: #f5222d;
}

.text-warning {
  color: #fa8c16;
}

.text-success {
  color: #52c41a;
}

.reject-tip {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  background: #fff1f0;
  color: #cf1322;
  font-size: 24rpx;
  line-height: 1.6;
}

.submit-btn {
  margin-top: 10rpx;
}

/* 底部弹层 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
}

.form-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  max-height: 80vh;
  overflow-y: auto;
  padding: 30rpx 30rpx 50rpx;
  border-radius: 24rpx 24rpx 0 0;
  background: #ffffff;
}

.form-head {
  margin-bottom: 20rpx;
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.form-close {
  font-size: 26rpx;
  color: #999999;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 26rpx;
  color: #666666;
}

.form-input,
.form-picker {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  background: #f7f8fa;
  font-size: 26rpx;
  color: #333333;
}

.form-textarea {
  width: 100%;
  box-sizing: border-box;
  height: 140rpx;
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
  background: #f7f8fa;
  font-size: 26rpx;
  color: #333333;
}
